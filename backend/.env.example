# Server Port (Render sets process.env.PORT automatically)
PORT=5000

# Allowed CORS origins (comma-separated). Set to your Vercel frontend URL in production:
# Example: ALLOWED_ORIGINS=https://resq-frontend.vercel.app,http://localhost:5173
# Leave as * or empty to allow all origins during development and preview deployments:
ALLOWED_ORIGINS=*

# Optional database folder path override (defaults to ../RESQ/data)
# DATA_DIR=../RESQ/data
