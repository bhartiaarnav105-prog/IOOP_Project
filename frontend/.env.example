# Backend API URL
# For production on Vercel, set this to your deployed Render backend URL:
# Example: VITE_API_URL=https://your-resq-backend.onrender.com
#
# For local development with standalone Node.js backend running on port 5000:
# VITE_API_URL=http://localhost:5000
#
# For local development using Vite's built-in dev server plugin:
# Leave blank (relative /api requests will be handled by Vite)
VITE_API_URL=
